# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل

# وضع التطوير: اتركه 1 محليًا، واجعله 0 (أو احذف السطر) في الإنتاج
DJANGO_DEBUG=1

# مفتاح سري عشوائي طويل — إلزامي في الإنتاج (DJANGO_DEBUG=0)
# ولّده مثلاً بالأمر: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# النطاقات المسموح للمشروع يعمل عليها، مفصولة بفواصل
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# نطاقات الواجهة الأمامية المسموح لها تنادي الـ API من المتصفح (مطلوبة في الإنتاج)
# مثال: CORS_ALLOWED_ORIGINS=https://app.mkmax.sd,https://mkmax.sd
CORS_ALLOWED_ORIGINS=

# اتركه فارغًا لاستخدام SQLite افتراضيًا (مناسب لمدرسة أو عدة مدارس بحمل محدود)
# أو اضبطه للانتقال إلى PostgreSQL بدون أي تعديل بالكود:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# إعادة التوجيه التلقائي لـ HTTPS في الإنتاج (اتركه كما هو إلا لو كان الخادم خلف
# reverse proxy يتولى هذا بنفسه، عندها اجعله 0 لتفادي حلقة إعادة توجيه)
DJANGO_SECURE_SSL_REDIRECT=1
